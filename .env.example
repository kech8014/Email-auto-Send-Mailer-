# ---------------------------------------------------------------- required --

# Access code for the console. Anyone with this string can send mail from the
# connected mailbox. Use something long.
ACCESS_CODE=change-me

# Master key used to derive the AES-256-GCM key that seals SMTP/IMAP passwords
# at rest, and to sign session and worker tokens. Rotating it invalidates every
# stored credential and session.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# ------------------------------------------------------- persistence (pick 1)

# Preferred: Upstash / Vercel KV REST. Strongly consistent, so the worker reads
# its own writes immediately. Either variable pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Fallback: Vercel Blob. No provisioning, adequate for a single campaign chain.
# BLOB_READ_WRITE_TOKEN=

# With neither set the store falls back to process memory: fine for local
# development, but campaign state dies with the process. /api/health warns.

# ---------------------------------------------------------------- optional --

# Absolute origin used by the worker to call itself for the next tick. On Vercel
# this is derived from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL automatically;
# set it explicitly if you run behind your own domain or a proxy.
# PUBLIC_BASE_URL=https://mailer.example.com

# Shared secret Vercel Cron sends as `Authorization: Bearer ...`. Set it so the
# hourly sweep endpoint cannot be triggered by anyone else.
# CRON_SECRET=

# Local development only.
# PORT=3400
